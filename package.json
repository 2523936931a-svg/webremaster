{
  "name": "webremaster",
  "version": "0.1.0",
  "private": true,
  "description": "WebRemaster — 全网老旧丑网站 Shadow-DOM React 重制编译器 + 零 Token 皮肤商店 + Chrome 扩展",
  "license": "MIT",
  "author": "WebRemaster Contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webremaster/webremaster.git"
  },
  "homepage": "https://webremaster.github.io/webremaster/",
  "bugs": {
    "url": "https://github.com/webremaster/webremaster/issues"
  },
  "keywords": [
    "userscript",
    "chrome-extension",
    "shadow-dom",
    "react19",
    "tailwindcss",
    "playwright",
    "web-modernization",
    "dark-mode",
    "legacy-website"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --filter @webremaster/schema build && pnpm --filter @webremaster/bridge build && pnpm --filter @webremaster/ui-kit build && pnpm --filter @webremaster/compiler build",
    "dev": "pnpm --filter @webremaster/store dev",
    "preview": "pnpm --filter @webremaster/store preview",
    "wr": "node packages/compiler/dist/cli.js",
    "sync:artifacts": "node packages/compiler/dist/cli.js sync-artifacts --skins ./skins --ext ./packages/extension --store ./packages/store",
    "build:ext": "pnpm sync:artifacts && pnpm --filter @webremaster/extension build",
    "build:store": "pnpm sync:artifacts && pnpm --filter @webremaster/store build",
    "build:all": "pnpm build && pnpm build:ext && pnpm build:store",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "doctor": "node packages/compiler/dist/cli.js doctor",
    "list": "node packages/compiler/dist/cli.js list",
    "bootstrap": "pnpm build",
    "set-owner": "node scripts/set-owner.mjs",
    "check:docs": "node scripts/check-docs-links.mjs",
    "check:all": "pnpm build && pnpm typecheck && pnpm test && pnpm build:all && pnpm check:docs",
    "test:all": "pnpm build && pnpm typecheck && pnpm test && pnpm build:all && pnpm check:docs"
  }
}
