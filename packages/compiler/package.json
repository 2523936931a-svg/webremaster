{
  "name": "@webremaster/compiler",
  "version": "0.1.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/2523936931a-svg/webremaster.git",
    "directory": "packages/compiler"
  },
  "description": "WebRemaster 编译器：Playwright DOM X-Ray 深度测绘、零闪烁单文件油猴打包引擎、SQLite LLM 缓存与三档熔断网关",
  "type": "module",
  "main": "./dist/cli.js",
  "types": "./dist/cli.d.ts",
  "bin": {
    "wr": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.0.9",
    "@webremaster/bridge": "workspace:*",
    "@webremaster/schema": "workspace:*",
    "@webremaster/ui-kit": "workspace:*",
    "better-sqlite3": "^13.2.0",
    "chalk": "^6.0.1",
    "commander": "^15.1.0",
    "dotenv": "^18.0.10",
    "lucide-react": "^1.77.0",
    "openai": "^7.62.0",
    "ora": "^10.0.0",
    "playwright": "^1.49.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.9",
    "vite": "^8.3.8",
    "yaml": "^2.7.0",
    "zod": "^4.6.7",
    "zod-to-json-schema": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
