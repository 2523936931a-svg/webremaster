{
  "name": "@webremaster/compiler",
  "version": "0.1.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/2523936931a-svg/webremaster.git",
    "directory": "packages/compiler"
  },
  "description": "WebRemaster 编译器：Playwright DOM X-Ray 深度测绘、零闪烁单文件油猴打包引擎、SQLite LLM 缓存与三档熔断网关",
  "type": "module",
  "main": "./dist/cli.js",
  "types": "./dist/cli.d.ts",
  "bin": {
    "wr": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.0.9",
    "@webremaster/bridge": "workspace:*",
    "@webremaster/schema": "workspace:*",
    "@webremaster/ui-kit": "workspace:*",
    "better-sqlite3": "^12.0.0",
    "chalk": "^5.4.1",
    "commander": "^12.1.0",
    "dotenv": "^16.4.7",
    "lucide-react": "^0.469.0",
    "openai": "^4.77.0",
    "ora": "^8.1.1",
    "playwright": "^1.49.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.9",
    "vite": "^6.0.7",
    "yaml": "^2.7.0",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
