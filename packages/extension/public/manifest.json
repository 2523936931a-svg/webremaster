{
  "manifest_version": 3,
  "name": "WebRemaster — Modernize Ugly Legacy Websites",
  "version": "1.0.0",
  "description": "Zero-token, Shadow-DOM React remasters for classic websites.",
  "permissions": ["storage", "scripting", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "WebRemaster"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "webremaster@webremaster.dev",
      "strict_min_version": "109.0"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
